# ============================================================
# Partner API — required for SSR pages + /api/health
# Both variables are SERVER-ONLY — never expose to client bundle.
# ============================================================

# Bearer token used to authenticate against the Partner API.
# Local dev:  use the seeded sandbox key from supabase/seed.sql in the
#             StreamHub repo (after running `supabase db reset`).
# Production: generate via the partner-admin Edge Function — see
#             StreamHub/docs/partner-api-setup.md
PARTNER_API_KEY=

# Base URL of the partner-api-v1 Edge Function (no trailing slash).
# Local dev:   http://127.0.0.1:54321/functions/v1/partner-api-v1
# Production:  https://<project-ref>.supabase.co/functions/v1/partner-api-v1
PARTNER_API_BASE_URL=

# ============================================================
# Supabase Auth — required for Sign-In flows (Story 7)
# Both variables are PUBLIC (NEXT_PUBLIC_ prefix); the anon key is safe
# to ship in the client bundle.
# ============================================================

# Supabase project URL.
# Local dev:   http://127.0.0.1:54321
# Production:  https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (publishable) key.
# Local dev:   from `npx supabase status` → "Publishable" row
# Production:  Supabase Dashboard → Project Settings → API → "anon public"
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Site URL used as the OAuth redirect base.
# Local dev:   http://localhost:3000
# Production:  https://streamertimes.tv
NEXT_PUBLIC_SITE_URL=

# Twitch application Client ID (PUBLIC — it appears in the OAuth URL anyway).
# Required for the "Import Twitch follows" flow (onboarding + settings), which
# runs a Twitch implicit-grant OAuth ROUND-TRIP INDEPENDENT of Supabase to fetch
# a short-lived user:read:follows token (lib/web/twitchConnect.ts). Use the SAME
# Client ID as the TWITCH_CLIENT_ID Supabase secret in the StreamHub backend.
# When unset, the import buttons degrade gracefully to "pick manually".
# ⚠ In the Twitch developer console (dev.twitch.tv/console/apps → your app →
#   OAuth Redirect URLs) add these EXACT redirect URIs alongside the existing
#   Supabase callback:
#     Production:  https://streamertimes.tv/auth/twitch-import
#     Local dev:   http://localhost:3000/auth/twitch-import
NEXT_PUBLIC_TWITCH_CLIENT_ID=

# ============================================================
# Google Analytics 4 (@next/third-parties/google)
# PUBLIC (NEXT_PUBLIC_ prefix, inlined at `next build`). GA4 Measurement ID in
# the form "G-XXXXXXXXXX" from the GA property's Web data stream. While unset,
# the <GoogleAnalytics> component renders nothing — no gtag.js on the page — so
# local/preview builds stay analytics-free. Set on Vercel (Production) +
# redeploy to activate.
# ============================================================
NEXT_PUBLIC_GA_ID=

# ============================================================
# On-demand revalidation — /api/revalidate (LIVE-badge pipeline)
# SERVER-ONLY. Shared secret with the StreamHub backend (same value as the
# REVALIDATE_SECRET Supabase secret). Generate: openssl rand -hex 32
# While unset the route is disabled (404).
# ============================================================
REVALIDATE_SECRET=

# ============================================================
# Feature flags
# ============================================================

# Website auth activation switch (see lib/auth-flag.ts). Auth ships DORMANT:
# unset/anything-but-"true" keeps the sign-in page redirecting to /app and the
# header without a user menu. Set to exactly "true" (+ redeploy — the value is
# inlined at build time) to enable sign-in, the header user menu, and
# login-gated redirects for /feed, /favorites, /settings.
# Prerequisite: Twitch + Google OAuth providers configured in the Supabase
# dashboard with <site-url>/auth/callback as redirect URL.
NEXT_PUBLIC_AUTH_ENABLED=

# Stealth mode for quiet production testing (see lib/auth-flag.ts). Only takes
# effect while NEXT_PUBLIC_AUTH_ENABLED is "true": auth works via direct URL
# (/auth/login, gated pages) but signed-out visitors get no entry point — no
# header "Sign in" link, FavoriteButton keeps its dormant /app behavior.
NEXT_PUBLIC_AUTH_LINKS_HIDDEN=

# Email login/registration sub-switch (see lib/auth-flag.ts). Only takes
# effect while NEXT_PUBLIC_AUTH_ENABLED is also "true". Set to exactly "true"
# (+ redeploy) to enable the email/password form on /auth/login plus the
# /auth/sign-up, /auth/forgot-password, and /auth/reset-password pages.
# Prerequisites (activation checklist in AGENTS.md): hCaptcha sitekey hostname,
# custom SMTP (Resend / streamertimes.info), conditional email templates.
NEXT_PUBLIC_EMAIL_AUTH_ENABLED=

# hCaptcha sitekey for the email-auth forms. The Supabase project enforces
# captcha on auth endpoints, so signUp / signInWithPassword /
# resetPasswordForEmail need a token. When unset, the forms skip captcha
# entirely (only valid against a stack with captcha disabled).
# Production: the app's sitekey (add streamertimes.tv as an allowed hostname
#             in the hCaptcha dashboard first).
# Local dev:  hCaptcha test sitekey 10000000-ffff-ffff-ffff-000000000001
#             (start the local Supabase stack with
#             HCAPTCHA_SECRET=0x0000000000000000000000000000000000000000).
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
